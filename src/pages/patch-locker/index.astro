---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Patch Locker" active="patch-locker">
  <div class="wrap">
    <p class="eyebrow">Self-Reported · Honor System</p>
    <h1>Patch Locker</h1>
    <p class="sub">Claim what you've earned. No login, no verification —<br>if you know you did it, take the patch.</p>
    <p class="sample-badge">Prototype — canvas-drawn placeholder art; real patch design comes later</p>

    <div class="card-grid">
      <a class="card" href="/patch-locker/full-send">
        <h3>Full Send</h3>
        <p>Region completion patches — Bronze, Silver, Gold based on how many AOs you've posted at.</p>
      </a>
      <a class="card" href="/patch-locker/elements">
        <h3>Elements</h3>
        <p>One-shot claim badges: One Is Enough, Sub-Zero, Centurion, Rainmaker, Yeti, Sherpa, Plogger, and more.</p>
      </a>
    </div>
  </div>
</BaseLayout>
