---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Home" active="home">
  <div class="wrap">
    <p class="eyebrow">0500 · The Gloom</p>
    <h1>F3 Fan Site</h1>
    <p class="sub">A couple of small tools for PAX — find somewhere new to post,<br>and claim the patches you've earned.</p>
    <p class="sample-badge">Fan-built prototype — not affiliated with or endorsed by F3 Nation</p>

    <div class="card-grid">
      <a class="card" href="/roulette">
        <h3>F3 Roulette</h3>
        <p>Enter your zip and how far you'll drive. We'll send you somewhere new to post.</p>
      </a>
      <a class="card" href="/patch-locker">
        <h3>Patch Locker</h3>
        <p>Claim Full Send region patches and Elements badges — honor system, no login.</p>
      </a>
    </div>
  </div>
</BaseLayout>
